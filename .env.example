# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# `scripts/run_phase0.py` loads this via python-dotenv (the `data` extra).

# Root of the mounted corpus volume. Loaders resolve every dataset `metadata`
# path (and the source audio it points to) under this directory.
DAGGER_DATA_ROOT=/mnt/data

# WSJ0-2mix only. WSJ0 has no API key — it is LDC-licensed. Leave BLANK when the
# corpus is already mounted under DAGGER_DATA_ROOT. Set it only to authorize a
# fetch of the licensed data from a private mirror / gated endpoint you control.
DAGGER_WSJ0_ACCESS_KEY=

# Phase 3 only. `pyannote/community-1` is a gated (but free) HuggingFace model:
# accept the terms on its model page, then put a read token here. Leave BLANK if
# the checkpoint is already cached locally or you set DAGGER_PYANNOTE_CKPT_PATH.
DAGGER_HF_TOKEN=

# Optional local override for the pyannote checkpoint, mirroring
# DAGGER_TITANET_CKPT_PATH. Takes precedence over the Hub, which is what makes
# an offline / no-token box able to run the real-diarization arms.
DAGGER_PYANNOTE_CKPT_PATH=
